# Bazaaro Production Environment Configuration

# 1. MongoDB Atlas Connection URI (Required)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
MONGODB_URI=""

# 2. Google Gemini AI API Key (Required for AI Shopping Guru)
GEMINI_API_KEY=""

# 3. ZapUPI Payment Gateway Key ID (Required for payments)
ZAPUPI_KEY_ID=""

# 4. ZapUPI Environment (sandbox | production, defaults to sandbox)
ZAPUPI_ENV="sandbox"

# 5. JWT Secret Key (Optional, random secure string)
JWT_SECRET=""

# 6. Server Port (Auto-injected by cloud hosts like Render, Railway)
PORT="3000"

# 7. Node Environment (production)
NODE_ENV="production"

