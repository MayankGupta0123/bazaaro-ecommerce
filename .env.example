# MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/bazaaro?retryWrites=true&w=majority"

# Google Gemini API Key (for Bazaaro AI Dost)
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini Model Identifier (Defaults to gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"

# ZapUPI Payment Gateway Credentials
ZAPUPI_KEY_ID="your_zapupi_key_id_here"
ZAPUPI_CASHIER_ID="3791"
ZAPUPI_GATEWAY_IP="72.61.225.127"
ZAPUPI_ENV="live"

# JWT Secret for User & Admin Authentication
JWT_SECRET="your_secure_jwt_secret_key"

# Server Port & Public Base URL
PORT=3000
NODE_ENV="development"
# Set to your live Render URL in production (e.g. https://bazaaro.onrender.com)
PUBLIC_BASE_URL="http://localhost:3000"
